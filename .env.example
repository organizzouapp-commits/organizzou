# Supabase (Project Settings > API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted as an alias.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
# Deprecated name, still read as a fallback. Prefer SUPABASE_SECRET_KEY below.
SUPABASE_SERVICE_ROLE_KEY=
# Admin area, server only. Secret key (sb_secret_...) from Project Settings > API Keys. Used by the admin write actions
# (change plan, suspend, ...) and by npm run admin:grant. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Base URL for every absolute link (OAuth redirect, e-mail links, Open Graph, canonical, sitemap).
# Production: NEXT_PUBLIC_SITE_URL=https://organizzouapp.com (see docs/DEPLOY-DOMINIO.md)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cookie consent: leave empty on localhost. Production: ".organizzouapp.com" so the app and the site share one choice.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Google sign-in (Supabase Auth > Providers > Google). Leave empty until the OAuth client is created.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=


# Assistant (server only, never NEXT_PUBLIC_). Without the key the chat says "Assistente indisponivel" and quick capture keeps working by rules.
ANTHROPIC_API_KEY=
# Optional. Default: claude-haiku-5-5
ASSISTANT_MODEL=

# E-mail (server only): support reports and the two-step codes. Resend (https://resend.com). Without them the app still works,
# the report form says the sending is not configured.
RESEND_API_KEY=
# A verified sender, e.g. "Organizzou <no-reply@your-domain>"
EMAIL_FROM=

# Web push (server only). Generate the pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach: mailto:organizzouapp@gmail.com
VAPID_SUBJECT=
# Protects /api/cron/notifications (Vercel sends it as a Bearer token). Any long random string.
CRON_SECRET=

# Two-step verification (server only): signs the proof that a session passed the second step. Any random string of 32+ characters
# (e.g. openssl rand -base64 48). Without it the second step cannot be turned on.
AUTH_COOKIE_SECRET=
