# Supabase (Project Settings > API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted as an alias.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cookie consent: leave empty on localhost. Use ".organizzou.com.br" so the app and the site share one choice.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Google sign-in (Supabase Auth > Providers > Google). Leave empty until the OAuth client is created.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Coming-soon page: true makes "/" show /em-breve to logged-out visitors (the page is always reachable at /em-breve).
SITE_COMING_SOON=false
