# Supabase (Project Settings > API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted as an alias.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL for every absolute link (OAuth redirect, e-mail links, Open Graph, canonical, sitemap).
# Production: NEXT_PUBLIC_SITE_URL=https://organizzouapp.com (see docs/DEPLOY-DOMINIO.md)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cookie consent: leave empty on localhost. Production: ".organizzouapp.com" so the app and the site share one choice.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Google sign-in (Supabase Auth > Providers > Google). Leave empty until the OAuth client is created.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

